# Copy to `.env` for local development. Never commit `.env`.
#
# NOTE: Anything prefixed with VITE_ is inlined into the client bundle and is
# therefore PUBLIC. Never put a secret (API token, private key) in here.

# Optional. Formspree form id (https://formspree.io) used by the contact form.
# If unset, the contact form falls back to opening the visitor's mail client.
VITE_FORMSPREE_ID=
